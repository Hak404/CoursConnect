# ============================================================
# CoursConnect - Variables d'environnement (local / docker-compose)
# Copiez ce fichier vers `.env` et remplissez les valeurs.
# N'importe JAMAIS `.env` dans Git (il est ignoré par .gitignore).
# Aucun secret ne doit être commité.
# ============================================================

# --- CORS backend (public, domaines autorisés séparés par des virgules) ---
# Liste des origines autorisées. Jamais "*" tant que des credentials sont utilisés.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Compte administrateur (BACKEND uniquement, jamais exposé au navigateur) ---
# Provisionné à chaque démarrage par AdminBootstrap (idempotent) :
# - crée le compte si absent (uniquement si ADMIN_PASSWORD est fourni)
# - garantit role=ADMIN + enabled sur le compte correspondant
ADMIN_EMAIL=weborax.dev@gmail.com
ADMIN_PASSWORD=

# --- Frontend Vercel (publique, exposée au navigateur via import.meta.env) ---
# Les variables frontend sont définies dans Vercel -> Project -> Settings ->
# Environment Variables (prefixe VITE_). Voir frontend/.env.example.
# VITE_API_URL =